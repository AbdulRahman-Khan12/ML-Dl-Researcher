# =============================================================
# ML & Deep Learning Study Research Agent — environment settings
# =============================================================
# Copy this file to ".env" and adjust if needed:
#     cp .env.example .env
#
# Everything here is OPTIONAL. The app has sensible defaults, and you can
# also change the model + research depth right from the Streamlit sidebar.
# These values (if set) take priority over the defaults in configuration.py.

# --- Search tool (free, no key needed) ----------------------
SEARCH_API='duckduckgo'        # 'duckduckgo' is free and needs no API key

# --- LLM provider (local) -----------------------------------
LLM_PROVIDER=ollama            # 'ollama' (recommended) or 'lmstudio'
LOCAL_LLM=mistral             # the model you pulled, e.g. 'ollama pull mistral'
OLLAMA_BASE_URL=http://localhost:11434   # default Ollama endpoint

# --- How hard the agent works -------------------------------
MAX_WEB_RESEARCH_LOOPS=2       # number of research + reflection cycles
FETCH_FULL_PAGE=True           # read full pages for richer notes

# --- Optional paid search APIs (NOT needed for this project) -
# Leave these blank unless you specifically want to use them.
# TAVILY_API_KEY=
# PERPLEXITY_API_KEY=
